# chapters/ch09/versions.tf
terraform {
  # Ephemeral values need 1.10; write-only arguments need 1.11.
  required_version = ">= 1.12"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.7"
    }
  }
}
